# Copy to .env and fill in once the Supabase project exists.
# Get these from: Supabase Dashboard -> Project Settings -> API

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Merchant of Record — decided: Paddle (see backend/src/billing/paddle.ts for why —
# Stripe Managed Payments doesn't support South Africa as an account home country
# without a foreign entity; PayPal has no MoR tax handling and a documented Nov-2025
# IPN outage causing exactly the "paid but not activated" failure mode).
# MOR_API_KEY is a Paddle API key; MOR_WEBHOOK_SECRET is the notification setting's
# secret key (Paddle Dashboard -> Developer Tools -> Notifications) for the
# /api/webhooks/mor endpoint. PADDLE_ENVIRONMENT=production switches out of sandbox
# once real — defaults to sandbox otherwise, a deliberate safety default.
# Also requires: Starter/Pro/Business Prices created in Paddle with their IDs
# below. Env var names reflect the CURRENT display names (Free/Starter/Pro/
# Business, restructured 2026-07-23) — the internal tier codes stored in the
# database ("pro"/"business"/"enterprise") were kept stable across the
# rename to avoid a live-data migration, so these names don't literally match
# the internal codes; see backend/src/tier.ts for the mapping.
# Leave all blank to keep running on StubMorAdapter.
MOR_API_KEY=
MOR_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=
PADDLE_PRICE_ID_STARTER=
PADDLE_PRICE_ID_PRO=
PADDLE_PRICE_ID_BUSINESS=

# Storage add-ons (2026-07-23) — Starter/Pro/Business only, not Free.
PADDLE_PRICE_ID_STORAGE_5GB=
PADDLE_PRICE_ID_STORAGE_20GB=
PADDLE_PRICE_ID_STORAGE_50GB=

# Optional — ops alerting (circuit-breaker trips, permanently-failed posts
# after retries are exhausted). Leave blank to just log to stderr/Render logs.
SLACK_WEBHOOK_URL=

# Platform API credentials — filled in once developer apps are registered (Phase 0).
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the TikTok app's Login Kit
# config — this is the real backend's own OAuth callback route.
TIKTOK_REDIRECT_URI=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Must exactly match the redirect URI registered on the Pinterest app's OAuth
# config — same backend callback route as TikTok's, since only one
# PlatformAdapter is wired app-wide at a time (see ACTIVE_PLATFORM in index.ts).
PINTEREST_REDIRECT_URI=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must exactly match the Authorized redirect URI on the Google Cloud OAuth
# client — same backend callback route as the other platforms.
YOUTUBE_REDIRECT_URI=
# No client id/secret — Mastodon app registration is self-service and
# happens automatically against the adapter's default instance. Same
# backend callback route as the other platforms.
MASTODON_REDIRECT_URI=
# The LazyRelay-hosted page that collects a Bluesky handle + app password
# (this adapter uses app passwords, not OAuth — see platforms/bluesky.ts).
# No client id/secret needed.
BLUESKY_CONNECT_PAGE_URL=
# REDESIGNED 2026-09-08 — no shared bot/token any more. Each customer
# creates their own bot via @BotFather and pastes the bot token + channel
# @username into LazyRelay's connect page; `accessToken` stores both as
# JSON per-customer. TELEGRAM_CONNECT_PAGE_URL is the only env var this
# adapter needs — it's just the LazyRelay-hosted page that collects those
# two values. See platforms/telegram.ts's class comment for why the old
# shared-bot model (TELEGRAM_BOT_TOKEN/TELEGRAM_LOG_CHAT_ID, both retired)
# couldn't support comment/DM reading and was replaced, not just patched.
TELEGRAM_CONNECT_PAGE_URL=
# Personal-profile-only scope (w_member_social) — self-serve, instant.
# Company Page posting (w_organization_social) needs LinkedIn's vetted
# Community Management API review and isn't what this adapter uses.
# Same backend callback route as every other platform.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Threads has its own auth/graph hosts, separate from a regular Facebook/
# Instagram Login app (threads.net for the authorize dialog,
# graph.threads.net for everything else). Scopes: threads_basic +
# threads_content_publish. Same backend callback route as every other
# platform.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=
# Facebook Page posting + Instagram Business posting — both use the SAME
# Meta app/credentials below (Facebook Login for Business), just different
# ACTIVE_PLATFORM adapters (facebook.ts posts to the connected Page,
# instagram.ts posts to that Page's linked Instagram Business Account).
# Same backend callback route as every other platform.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Posting still needs no OAuth — a Discord channel webhook URL IS the
# credential. DISCORD_CONNECT_PAGE_URL is the LazyRelay-hosted page that
# collects it (customer creates one via Channel Settings -> Integrations
# -> Webhooks -> New Webhook -> Copy Webhook URL).
DISCORD_CONNECT_PAGE_URL=
# ADDED 2026-09-08 for comment reply: a real Discord Developer Application
# now exists (bot user, Message Content Intent, View Channels/Send
# Messages/Read Message History) — one shared bot across every customer,
# unlike Telegram's per-customer redesign above (this is how Discord bots
# actually work: its own permission model already scopes what a bot can
# see to servers it's invited into). DISCORD_BOT_TOKEN is optional --
# posting via webhook works without it; reply/comments just no-op cleanly
# until it's set (see registry.ts/discord.ts's class comment). Customers
# invite the bot via a static link, no OAuth code exchange needed.
DISCORD_BOT_TOKEN=
# Real OAuth 2.0 (Tumblr supports both 2.0 and legacy 1.0a — this adapter
# uses 2.0). Same backend callback route as every other platform.
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=
TUMBLR_REDIRECT_URI=

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=


# Reuses the same Google Cloud project/OAuth client as YOUTUBE_CLIENT_ID
# above is fine (one client, multiple scopes) -- but the business.manage
# scope needs adding to that OAuth consent screen, AND Google Business
# Profile APIs are separately gated behind an access-request form Google
# must approve before the API is even callable. Adapter is code-complete;
# these three vars plus that approval are both required before this can go
# live for any customer. See platforms/googleBusiness.ts.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REDIRECT_URI=

# A separate, dedicated Google Cloud OAuth client from the Business Profile
# one above -- do not reuse that client's credentials here. See
# googleCalendar/oauthClient.ts's header comment for why.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

ANTHROPIC_API_KEY=

# Optional -- AI observability (cost/latency/quality tracking) on every
# Anthropic call, wired via createAnthropicClient() in posthogClient.ts.
# Leave blank to keep every Anthropic-backed feature working exactly as
# before, just without the extra tracking. Same PostHog project as the
# frontend's session replay/product analytics, US data region.
POSTHOG_API_KEY=
