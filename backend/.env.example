# Copy to .env and fill in once the Supabase project exists.
# Get these from: Supabase Dashboard -> Project Settings -> API

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Merchant of Record (Paddle or Lemon Squeezy) — filled in once that account exists.
MOR_API_KEY=
MOR_WEBHOOK_SECRET=

# Platform API credentials — filled in once developer apps are registered (Phase 0).
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
