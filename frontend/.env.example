VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
VITE_TURNSTILE_SITE_KEY=

# Paddle.js client-side token — Paddle Dashboard -> Developer Tools ->
# Authentication -> Client-side tokens. Safe to expose (not a secret).
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=sandbox

# Content Sources tab (competitor research page, a thin client for a separate service). The tab shows only when BOTH flags
# below are exactly "true"; either one off and there is no tab. The service address serves the competitor box and the
# status panel. Empty means no request is made and the status panel says Unknown.
VITE_CONTENT_SOURCES_ENABLED=
VITE_COMPETITOR_MODE_ENABLED=
VITE_CONTENT_SOURCES_API_URL=

# Credit-wallet billing screens (balance in the header, balance card and buy panel in Settings). Build-time and exact: only the
# word "true" turns them on. Default off: with it unset the build carries none of the billing screens and every account sees
# the existing plan cards. Turn it on only when the server wallet is on too (the server answers 404 while it is off, and the
# screens then behave as if billing were off).
# LazyCredits. When exactly "true", the competitor box asks the LazyRelay backend for the blueprint (it charges credits)
# instead of calling the engine from the browser. Unset or anything else: unchanged behaviour. Needs the backend route.
VITE_BILLING_ENABLED=
