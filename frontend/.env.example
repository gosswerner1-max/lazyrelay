VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
VITE_TURNSTILE_SITE_KEY=

# Paddle.js client-side token — Paddle Dashboard -> Developer Tools ->
# Authentication -> Client-side tokens. Safe to expose (not a secret).
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=sandbox

# Content Sources tab (a thin client for a separate service). The tab is off unless the flag is exactly "true".
# The service address is empty until that service exists; empty means every check answers "Not connected yet" and no request is made.
VITE_CONTENT_SOURCES_ENABLED=
VITE_CONTENT_SOURCES_API_URL=
