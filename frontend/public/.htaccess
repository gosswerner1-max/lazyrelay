# Security headers for the static site (Apache/cPanel hosting) — added
# after a security review found the live site had none of these.
<IfModule mod_headers.c>
  # CSP started in Report-Only (2026-08-25) rather than enforcing, on
  # purpose -- Paddle.js renders the real, live checkout overlay on the
  # Dashboard (paddle.Checkout.open(), see Dashboard.tsx), and no official
  # Paddle CSP domain list exists to copy from. Report-Only logs what
  # WOULD have been blocked without actually blocking anything, so the
  # real domains Paddle needs can be read from a live checkout attempt's
  # own console violations instead of guessed. Deliberately leaves Paddle's
  # own script/frame/connect domains OUT of this draft so they show up as
  # violations to confirm exactly what's needed -- do not flip this to the
  # enforcing Content-Security-Policy header until that's been done and
  # verified against a real (non-payment) checkout-overlay open.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://qbmejnmyqogotdzzzyvj.supabase.co https://lazyrelaylazyrelay-backend.onrender.com https://www.google-analytics.com https://region1.google-analytics.com; frame-src 'self' https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'"
  # Forces HTTPS on every future visit, including the very first navigation
  # typed as http://. 1 year, includeSubDomains — the site has no non-HTTPS
  # subdomains that need to stay reachable over plain http.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Blocks the page from being framed by another site — no legitimate
  # reason for LazyRelay's dashboard or marketing pages to be embedded in
  # someone else's iframe, so this closes off clickjacking.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Stops the browser from guessing a different content-type than what's
  # declared, which is what makes some XSS/MIME-confusion tricks work.
  Header always set X-Content-Type-Options "nosniff"

  # Sends the full referrer only to LazyRelay's own origin; cross-origin
  # requests (e.g. an outbound link) get just the origin, not the full
  # path/query — a reasonable default that doesn't break analytics.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # The dashboard never asks for camera/mic/location access, so there's no
  # reason any embedded content should be able to either.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# SPA fallback — added 2026-08-21 after /pricing and /dpa (both real React
# routes, no matching static file) were found returning hard 404s on a
# direct/cold load, despite both being listed in sitemap.xml. Only catches
# requests that aren't a real file or directory, so static content (guides,
# terms, images, JS bundles, etc.) is untouched.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real gap found 2026-08-25 via securityheaders.com: the HSTS header above
  # was assumed to force HTTPS on a first http:// visit, but that's not how
  # HSTS works -- it only protects a visitor who's already connected
  # securely once before. Without a real redirect, http://lazyrelay.com
  # served the site directly over plain, unencrypted HTTP. This rule must
  # run before the SPA fallback below so an insecure request gets redirected
  # rather than served.
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
