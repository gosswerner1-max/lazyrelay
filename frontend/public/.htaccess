# Security headers for the static site (Apache/cPanel hosting) — added
# after a security review found the live site had none of these.
<IfModule mod_headers.c>
  # CSP ran in Report-Only for one real checkout attempt (2026-08-25) before
  # this enforcing header was written -- Paddle.js renders the real, live
  # checkout overlay on the Dashboard (paddle.Checkout.open(), see
  # Dashboard.tsx), and no official Paddle CSP domain list exists to copy
  # from. The Report-Only draft deliberately left Paddle's script/frame/
  # connect domains out so a live "Upgrade to Starter" attempt (disposable
  # test account, closed before the Payment step -- no card details ever
  # entered) would surface exactly what's needed instead of a guess.
  # Confirmed via performance.getEntriesByType('resource') + a document
  # iframe scan on the live overlay: cdn.paddle.com (Paddle.js loader,
  # script-src), buy.paddle.com (checkout iframe + its own API calls,
  # frame-src + connect-src), public.profitwell.com (Paddle's built-in
  # retention script, loads automatically, script-src). Everything else in
  # this policy was already covered by the draft. This is now enforcing --
  # re-verify with a fresh (non-payment) checkout-overlay open after any
  # change to this header, since Paddle can add domains without notice.
  # img-src widened 2026-08-29 -- real bug found, not a third-party
  # flakiness issue as earlier notes assumed: the footer's Startup Fame and
  # Smol Launch badges were silently failing to load for every real visitor
  # (curl never enforces CSP, so command-line checks always looked fine
  # while the actual browser-rendered <img> was blocked the whole time).
  # Scoped to the exact badge-image hosts in use, not a wildcard. Turbo0
  # badge host (img.turbo0.com) added 2026-08-29, same reason as the other
  # two -- an unlisted host here means the footer badge silently fails to
  # render for every real visitor even though curl never catches it.
  # SaaS Cubes badge host (saascubes.com) added same day, same reason.
  # ListMySaaS badge host (listmysaas.xyz) added same day, same reason.
  # Findly.tools badge host (findly.tools) added 2026-08-29, same reason as
  # the other four -- an unlisted host here means the footer badge silently
  # fails to render for every real visitor even though curl never catches it.
  # Fazier badge host (fazier.com) added same day, same reason.
  # Twelve Tools badge host (twelve.tools) added same day, same reason.
  # Wired Business badge host (wired.business) added same day, same reason.
  # SaaSHub badge host (cdn-b.saashub.com) added 2026-08-31, same reason as
  # the rest -- an unlisted host here means the footer badge silently fails
  # to render for every real visitor even though curl never catches it.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://challenges.cloudflare.com https://cdn.paddle.com https://public.profitwell.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://startupfa.me https://smollaunch.com https://img.turbo0.com https://saascubes.com https://listmysaas.xyz https://findly.tools https://fazier.com https://twelve.tools https://wired.business https://cdn-b.saashub.com https://web-review.com; font-src 'self'; connect-src 'self' https://qbmejnmyqogotdzzzyvj.supabase.co https://lazyrelaylazyrelay-backend.onrender.com https://www.google-analytics.com https://region1.google-analytics.com https://buy.paddle.com; frame-src 'self' https://challenges.cloudflare.com https://buy.paddle.com; object-src 'none'; base-uri 'self'"
  # Forces HTTPS on every future visit, including the very first navigation
  # typed as http://. 1 year, includeSubDomains — the site has no non-HTTPS
  # subdomains that need to stay reachable over plain http.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Blocks the page from being framed by another site — no legitimate
  # reason for LazyRelay's dashboard or marketing pages to be embedded in
  # someone else's iframe, so this closes off clickjacking.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Stops the browser from guessing a different content-type than what's
  # declared, which is what makes some XSS/MIME-confusion tricks work.
  Header always set X-Content-Type-Options "nosniff"

  # Sends the full referrer only to LazyRelay's own origin; cross-origin
  # requests (e.g. an outbound link) get just the origin, not the full
  # path/query — a reasonable default that doesn't break analytics.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # The dashboard never asks for camera/mic/location access, so there's no
  # reason any embedded content should be able to either.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Real gap found 2026-08-26: no Cache-Control header existed anywhere on the
# site, so every HTML response (the SPA shell, every static crawler page)
# fell back to browser heuristic caching. Confirmed live: a real returning
# visitor's browser kept serving a stale cached "/" -- with that morning's
# already-reverted, WRONG GA4 measurement ID still baked in -- long after
# the fix had deployed and curl (uncached) already showed the correct one.
# "no-cache" does NOT mean "don't cache" -- it means the browser must always
# revalidate with the server (a cheap conditional GET against the existing
# Last-Modified header) before reusing a cached copy, so a deploy is visible
# on the very next load instead of whenever the browser's heuristic cache
# happens to expire. Scoped to .html files only -- the content-hashed files
# under /assets/ change filename whenever their content changes, so they can
# and should stay on Apache's default long-cache behavior untouched.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# SPA fallback — added 2026-08-21 after /pricing and /dpa (both real React
# routes, no matching static file) were found returning hard 404s on a
# direct/cold load, despite both being listed in sitemap.xml. Only catches
# requests that aren't a real file or directory, so static content (guides,
# terms, images, JS bundles, etc.) is untouched.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real gap found 2026-08-25 via securityheaders.com: the HSTS header above
  # was assumed to force HTTPS on a first http:// visit, but that's not how
  # HSTS works -- it only protects a visitor who's already connected
  # securely once before. Without a real redirect, http://lazyrelay.com
  # served the site directly over plain, unencrypted HTTP. This rule must
  # run before the SPA fallback below so an insecure request gets redirected
  # rather than served.
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
