    "directory": "mcp-server"
  },
  "type": "module",
  "bin": {
    "lazyrelay-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/sync-tools.mjs && tsc",
    "start": "node dist/index.js",
    "sync-tools": "node scripts/sync-tools.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "prettier": "^3.9.6",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2"
  }
}
