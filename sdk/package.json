{
  "name": "@lazyrelay/sdk",
  "version": "0.1.0",
  "description": "Official Node SDK and command-line tool for LazyRelay: schedule and publish social posts, upload media, read analytics and manage client approvals through the LazyRelay REST API. Typed, zero dependencies.",
  "homepage": "https://lazyrelay.com/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/gosswerner1-max/lazyrelay",
    "directory": "sdk"
  },
  "keywords": [
    "lazyrelay",
    "social-media",
    "scheduler",
    "sdk",
    "cli"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "lazyrelay": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && node scripts/postbuild.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^5.5.0",
    "vitest": "^5.0.0"
  }
}
