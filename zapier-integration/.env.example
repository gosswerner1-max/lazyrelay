# Copy to .env (gitignored) and fill in for `npm test`.
# Generate a real API key from the LazyRelay dashboard: Settings -> API Keys
# (requires a paid plan — Starter, Pro, or Business).
LAZYRELAY_API_KEY=

# Optional: point tests at a non-production backend.
# LAZYRELAY_API_BASE_URL=http://localhost:3000/api

# Optional, only needed for the live "schedule a real post" test — a real
# social_accounts.id from that same test account (GET /social-accounts).
TEST_SOCIAL_ACCOUNT_ID=
